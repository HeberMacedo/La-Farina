{
  "name": "tpizza-artesanal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "bancojson": "node server/server.js",
    "start": "node server/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "demo:trafego": "node scripts/gerar-trafego.js"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "core-js": "^3.8.3",
    "json-server": "^0.17.4",
    "vue": "^3.2.13",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "server/**/*.js",
      "src/services/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json-summary"
    ]
  }
}
